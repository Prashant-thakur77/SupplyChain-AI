{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * 1"
    }
  ],
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "app/api/agent/incident/route.ts": {
      "maxDuration": 300
    },
    "app/api/agent/analysis/route.ts": {
      "maxDuration": 300
    },
    "app/api/agent/chat/route.ts": {
      "maxDuration": 120
    },
    "app/api/demo/incident/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/scan/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/digest/route.ts": {
      "maxDuration": 60
    }
  }
}
